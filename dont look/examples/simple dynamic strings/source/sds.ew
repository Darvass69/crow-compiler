// "##" means preprocessor/generic over name
// "$" means compile time only

enum SDS_TYPE: uint3 {
  _5,
  _8,
  _16,
  _32,
  _64
};

type Header5 = {
  //TODO how does the compiler get len and type? Bitshift + mask?
  {len: u5; type: SDS_TYPE._5}: uint8
}

type Header##N<N: 8|16|32|64> = {
  {infer; type: SDS_TYPE._##N}: uint8
  len: uint##N;
  alloc: uint##N;
} where (self.len <= self.alloc)

//? offset pointer start to be at the start of the buffer so we can use it in most string functions?
type SRS<N: 5|8|16|32|64> = {
  Header##N;
  //? cast it to string?
  buffer: char[];
} where (self.buffer.$length == (N == 5 ? self.len : self.alloc))
  & (self.buffer.$length >= 0)



