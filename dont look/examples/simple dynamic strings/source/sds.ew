enum SDS_TYPE {
  _5,
  _8,
  _16,
  _32,
  _64
}: uint3;

type Header5 = {
  {len: u5; type: SDS_TYPE._5}: uint8
} & self.alloc == self.len //?

//& how do we make the type a generic over the enum?
// type Header<T extends (uint8 | uint16 | uint32 | uint64)> = {
//   {infer; type: SDS_TYPE}: uint8
//   len: T;
//   alloc: T;
// }

type Header8 = {
  {infer; type: SDS_TYPE._8}: uint8
  len: uint8;
  alloc: uint8;
}

type Header16 = {
  {infer; type: SDS_TYPE._16}: uint8
  len: uint16;
  alloc: uint16;
}

type Header32 = {
  {infer; type: SDS_TYPE._32}: uint8
  len: uint32;
  alloc: uint32;
}

type Header64 = {
  {infer; type: SDS_TYPE._64}: uint8
  len: uint64;
  alloc: uint64;
}

//? no? or implied/inferred?
// comptime condition HeaderInfo {
//   const MAX_LEN: usize
// }

// impl HeaderInfo for Header5  { MAX_LEN = 31 }
// impl HeaderInfo for Header8  { MAX_LEN = 255 }
// impl HeaderInfo for Header16 { MAX_LEN = 65535 }
// impl HeaderInfo for Header32 { MAX_LEN = 2^32 - 1 }
// impl HeaderInfo for Header64 { MAX_LEN = 2^64 - 1 }
//?

//? how do we handle header 5 being different?
//? How do we create fake fields (or getter/setter but not dynamic in any way?)
type Header = (Header5) & (self.len == self.alloc) | (Header8 | ...) & (self.len <= self.alloc)

//? Make length a generic?
type SDS<H extends Header> = {
  H;
  buffer: char[]; //! dyn array at the end of the struct, array of size 0 doesn't have memory footprint?
} & (self.buffer.length == self.alloc)

/** length */
fn sdslen(s: *SDS) -> size_t {
  switch (s.type) { //TODO how do we resolve that?
    case SDS_TYPE._5: return s.len
    ...
  }
}

/** available */
fn sdsavail(s: *SDS) -> size_t {
  switch (s.type) { //? or match?
    case SDS_TYPE._5: return 0;
    case SDS_TYPE._8: {return s.alloc - s.len}
    ...
  }
  //Cover all values
}

/* set length */
//TODO what if new len > allocated?
//TODO this might be typed so that newlen is only as big as needed? (like uint8 for a hdr8)
fn sdssetlen(s: *SDS, newlen: size_t) {
  switch (s.type) { 
    case SDS_TYPE._5: {s.len = newlen} break; //TODO how do we resolve that?
    case SDS_TYPE._8: {s.len = newlen} break;
    ...
  }
}

/** increment length */
fn sdsinclen(s: *SDS, inc: size_t) {
  switch (s.type) {
    case SDS_TYPE._5: {s.len += inc} break; //TODO how do we resolve that?
    case SDS_TYPE._8: {s.len += inc} break;
    ...
  }
}

/** allocated */
fn sdsalloc(s: *SDS) {
  switch (s.type) {
    case SDS_TYPE._5: return s.len;
    case SDS_TYPE._8: return s.alloc;
    ...
  }
}

/** set allocated */
fn sdssetalloc(s: *SDS, newlen: size_t) {
  switch (s.type) {
    case SDS_TYPE._5: break;
    case SDS_TYPE._8: {s.alloc = newlen} break;
    ...
  }
}

private sdsHdrSize(type: SDS_TYPE) -> int {
  switch (type) {
    case SDS_TYPE._5: return sizeof(SDS<Header5>);
    ...
  }
}

private sdsReqType(string_size: size_t) -> SDS_TYPE {
  if (string_size < 1<<5)
    return SDS_TYPE._5;
  if (string_size < 1<<8)
    return SDS_TYPE._8;
  if (string_size < 1<<16)
    return SDS_TYPE._16;
  if (string_size < 1<<32)
    return SDS_TYPE._32;
  return SDS_TYPE._64;
}

/* Create a new sds string with the content specified by the 'init' pointer
 * and 'initlen'.
 * If NULL is used for 'init' the string is initialized with zero bytes.
 * If SDS_NOINIT is used, the buffer is left uninitialized;
 *
 * The string is always null-terminated (all the sds strings are, always) so
 * even if you create an sds string with:
 *
 * mystring = sdsnewlen("abc",3);
 *
 * You can print the string with printf() as there is an implicit \0 at the
 * end of the string. However the string is binary safe and can contain
 * \0 characters in the middle, as the length is stored in the sds header.
 */
fn sdsnewlen(init: *string | null | SDS_NOINIT, initlen: size_t) -> *SDS {
  void *sh;
  var s: *SDS;
  /* Empty strings are usually created in order to append. Use type 8
   * since type 5 is not good at this. */
  const type: SDS_TYPE = initlen == 0 ? SDS_TYPE._8 : sdsReqType(initlen);
  const headerLength = sdsHdrSize(type);

  s = malloc(headerLength+initlen+1) //! allocate the header + the buffer + 1 for \0
  //TODO should be something like malloc(sizeof(SDS<type> & self.buffer.length == initlen + 1))
  if (s == NULL) return NULL; //? how do we do that?

  //~ This might be useless if we set to 0 by default
  if (init==SDS_NOINIT)
    init = NULL;
  else if (!init)
    memset(sh, 0, hdrlen+initlen+1);

  switch(type) {
    case SDS_TYPE._5: {
      s.type = type;
      s.len = initlen;
      break;
    }
    case SDS_TYPE_8: {
      s.type = type;
      s.len = initlen;
      s.alloc = initlen;
      break;
    }
    ...
  }

  if (initlen && init)
    memcpy(s, init, initlen);
  sds.buffer[initlen] = '\0';
  return sds;
}

