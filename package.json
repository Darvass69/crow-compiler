{
  "name": "crow-compiler",
  "type": "module",
  "version": "0.0.0",
  "description": "Compiler for the Crow programming language.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "main": "npx tsx --tsconfig tsconfig.app.json src/main.ts",
    "file": "npx tsx --tsconfig tsconfig.app.json",
    "test": "vitest run --printConsoleTrace=true --silent=false"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/expect": "^4.0.9",
    "@vitest/runner": "^4.0.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.9"
  }
}